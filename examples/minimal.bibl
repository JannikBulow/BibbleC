class Test {
    int a;
    int b;

    Test(int a, int b) {
        this.a = a;
        this.b = b;
    }

    int sum() {
        return this.a + this.b;
    }
}

const int ARRAY_SIZE = 67;

int main() {
    int[] ints = new int[ARRAY_SIZE];
    for (int i = 0; i < ARRAY_SIZE; i += 1) {
        ints[i] = 5;
    }
    Test test = new Test(34, 35);
    return test.sum();
}